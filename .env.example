# 主服务端口（默认 3001，在 package.json 中设置）
# PORT="3001"

DATABASE_URL="file:./dev.db"

# AI Provider: "deepseek" | "openai" (default: deepseek)
AI_PROVIDER="deepseek"

# DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"

SMTP_FROM=""

# Admin token for protected API endpoints (settings, etc.)
# 生产环境必须设置强随机值
ADMIN_TOKEN=""

# MarkItDown 内部转换服务（URL 转 Markdown）
# MARKITDOWN_HOST="127.0.0.1"
# MARKITDOWN_PORT="3002"
# 或者直接指定完整 URL（优先级更高）:
# MARKITDOWN_URL="http://127.0.0.1:3002"

# Encryption key for sensitive settings (API keys)
ENCRYPTION_KEY=""
